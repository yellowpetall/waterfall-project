<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="950.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stc.usermanagement.HRDashboardController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label text="STC HR Dashboard">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label fx:id="welcomeLabel" text="Welcome HR!" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #ffcdd2;" text="Logout" />
         </children>
      </HBox>

      <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab text="User Management">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label text="Username:" />
                              <TextField fx:id="newUsernameField" prefWidth="140.0" promptText="username" />
                              <Label text="Password:" />
                              <PasswordField fx:id="newPasswordField" prefWidth="140.0" promptText="password" />
                              <Label text="Role:" />
                              <ComboBox fx:id="newRoleCombo" prefWidth="140.0" />
                              <Button mnemonicParsing="false" onAction="#handleAddUser" style="-fx-background-color: #c8e6c9;" text="Add User" />
                              <Button mnemonicParsing="false" onAction="#handleDeleteUser" style="-fx-background-color: #ffcdd2;" text="Delete Selected" />
                           </children>
                        </HBox>
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="userIdCol" prefWidth="60.0" text="ID" />
                              <TableColumn fx:id="userNameCol" prefWidth="180.0" text="Username" />
                              <TableColumn fx:id="userRoleCol" prefWidth="140.0" text="Role" />
                              <TableColumn fx:id="userActionsCol" prefWidth="220.0" text="Change Role" />
                           </columns>
                        </TableView>
                        <Label fx:id="userStatusLabel" text="" textFill="#1565c0" />
                     </children>
                  </VBox>
               </content>
            </Tab>

            <Tab text="All Timesheets">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Filter Status:" />
                              <ComboBox fx:id="tsStatusFilterCombo" onAction="#handleTimesheetFilter" prefWidth="160.0" />
                              <Label text="Employee:" />
                              <ComboBox fx:id="tsEmployeeFilterCombo" onAction="#handleTimesheetFilter" prefWidth="160.0" />
                              <Button mnemonicParsing="false" onAction="#handleTimesheetRefresh" text="Refresh" />
                              <HBox HBox.hgrow="ALWAYS" />
                              <Label fx:id="tsCountLabel" text="0 entries" textFill="#757575" />
                           </children>
                        </HBox>
                        <TableView fx:id="timesheetsTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="tsEmployeeCol" prefWidth="120.0" text="Employee" />
                              <TableColumn fx:id="tsProjectCol" prefWidth="110.0" text="Project" />
                              <TableColumn fx:id="tsDateCol" prefWidth="100.0" text="Date" />
                              <TableColumn fx:id="tsStartCol" prefWidth="80.0" text="Start" />
                              <TableColumn fx:id="tsEndCol" prefWidth="80.0" text="End" />
                              <TableColumn fx:id="tsBreakCol" prefWidth="70.0" text="Break" />
                              <TableColumn fx:id="tsTotalCol" prefWidth="75.0" text="Total" />
                              <TableColumn fx:id="tsStatusCol" prefWidth="90.0" text="Status" />
                              <TableColumn fx:id="tsReasonCol" prefWidth="160.0" text="Rejection Reason" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>

            <Tab text="Flex Time Summary">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Target hours per month:" />
                              <TextField fx:id="targetHoursField" prefWidth="80.0" text="160" />
                              <Button mnemonicParsing="false" onAction="#handleFlexRefresh" text="Recalculate" />
                              <HBox HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="flexTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="flexEmployeeCol" prefWidth="180.0" text="Employee" />
                              <TableColumn fx:id="flexActualCol" prefWidth="160.0" text="Approved Hours" />
                              <TableColumn fx:id="flexTargetCol" prefWidth="160.0" text="Target Hours" />
                              <TableColumn fx:id="flexBalanceCol" prefWidth="160.0" text="Flex Balance" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>
